  "narrative": {
    "northStar": "Neon After Hours",
    "overview": "A flat black room lit by one neon sign. The glitching, pink-tubed wordmark is the sign; everything else is a quiet console: hairline-ruled panels, monospace body text, pixel-mono labels, and square corners.",
    "keyCharacteristics": ["Flat near-black ground, no gradients behind content, no rounded corners anywhere.","1px hairline grids instead of cards with shadows.","Three type voices: Inter ExtraBold lowercase headings, Inconsolata body, Departure Mono uppercase labels.","Pink is a signal, green is a pass, grey is everything else."],
    "rules": [
      { "name": "The Signal-Only Rule", "body": "Pink marks state, verdict, or action. It is never decoration. The sanctioned identity exceptions are the wordmark outline and solid pink on a heading's emphasized word.", "section": "colors" },
      { "name": "The No-White Rule", "body": "The brightest text is paper (#cacccc). Never pure #fff.", "section": "colors" },
      { "name": "The Lowercase Shout Rule", "body": "Display headings are always lowercase, ExtraBold, negatively tracked. Labels are always uppercase mono.", "section": "typography" },
      { "name": "The Hairline Rule", "body": "Separation is a 1px line border or a 1px grid gap, never a shadow or a lifted card.", "section": "elevation" }
    ],
    "dos": ["Do separate content with 1px hairlines and grid gaps.","Do reserve pink for verdicts, active state, and actions (The Signal-Only Rule).","Do keep headings lowercase Inter 800 and labels uppercase Departure Mono.","Do keep every slide inside the shared frame so panels line up between slides.","Do disable reveal, glitch, and snap under prefers-reduced-motion."],
    "donts": ["Don't round corners or add drop shadows.","Don't use pure white text or a non-black background.","Don't add a pointer-following glow or disc on the black ground (removed deliberately).","Don't introduce new accent hues beyond pink and green for UI state."]
  }
